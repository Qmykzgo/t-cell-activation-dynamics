# =============================================================================
# .gitignore — T-cell Activation Dynamics
# =============================================================================

# ── R ─────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Renviron

# ── renv ──────────────────────────────────────────────────────────────────────
renv/library/
renv/python/
renv/staging/
renv/.cache/
# DO commit: renv.lock, renv/activate.R, renv/settings.json

# ── targets store ─────────────────────────────────────────────────────────────
_targets/
# Individual targets can be committed explicitly if needed

# ── Downloaded data (large, re-downloadable from GEO) ─────────────────────────
data/geo_raw/
data/*.gz
data/*.fastq*
data/*.bam
data/*.sam

# Keep placeholder
!data/.gitkeep

# ── Large result files ─────────────────────────────────────────────────────────
results/rds/
# DO commit: results/tables/*.csv (small text outputs)

# ── Rendered outputs (generated by make report) ───────────────────────────────
analysis_report.html
analysis_report.pdf
analysis_report_files/

# ── Quarto cache ──────────────────────────────────────────────────────────────
*_cache/
*_files/
.quarto/

# ── Figures (regenerated by pipeline) ────────────────────────────────────────
figures/*.png
figures/*.pdf
figures/*.svg
# Commit a /figures/README.md describing each figure
!figures/README.md

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ── Python (if any helper scripts) ────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# ── Conda ─────────────────────────────────────────────────────────────────────
.conda/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
Rplots.pdf
